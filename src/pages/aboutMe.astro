---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Mariana Ferrari — Sobre mí" activeTab="aboutMe">
  <h1
    slot="header-title"
    class="brand-title header-title"
    transition:name="brand-name"
  >
    MARIANA FERRARI
  </h1>

  <div class="content-about">
    <div class="picture-aboutMe">
      <img
        class="mask-reveal"
        src="https://res.cloudinary.com/dabfmsocx/image/upload/v1790534934/mariana-pictures/aboutMe-Mariana-picture_irzhj2.webp"
        alt="Mariana Ferrari"
      />
      <div class="blur-overlay"></div>
    </div>

    <div class="text-about">
      <p>
        Soy licenciada en Comunicación Audiovisual, con formación en creación de
        contenidos, producción y edición. Me interesa especialmente el
        desarrollo de proyectos que combinen lo creativo con lo estratégico, ya
        sea en el ámbito audiovisual, digital o de redes sociales.
      </p>
      <p>
        A lo largo de mi formación adquirí herramientas en narrativa, lenguaje
        visual y gestión de contenidos, que aplico con una mirada atenta a los
        detalles y a las tendencias actuales. Me destaco por mi compromiso, mi
        capacidad de adaptación y mis ganas constantes de aprender.
      </p>
      <p>
        La fotografía es, para mí, una extensión natural de esa mirada
        narrativa: un espacio donde puedo trabajar la composición, la luz y el
        encuadre para contar historias con una sola imagen. Cada proyecto
        fotográfico lo abordo como una oportunidad para experimentar,
        perfeccionar mi técnica y desarrollar un estilo propio, siempre atenta
        al contexto y al mensaje que quiero transmitir.
      </p>
      <hr class="hr" />
      <div class="goals-container">
        <h2 class="title-about">Mis Logros</h2>
        <div class="ucu">
          <img
            class="ucu-logo"
            src="https://res.cloudinary.com/dabfmsocx/image/upload/v1790536542/samples/Logo-Universidad-Catolica_okmf1w.svg"
            alt="Logo Universidad Católica"
          />
          <span class="line"></span>
          <span class="ucu-text">Lic. Comunicación Audiovisual</span>
        </div>
      </div>
    </div>
  </div>
</Layout>
<script>
  // Instalar primero: npm install motion
  import { animate, inView, stagger } from "motion";

  document.addEventListener("astro:page-load", () => {
    animate(
      ".text-about p",
      { y: [55, 0], opacity: [0, 1] },
      { delay: stagger(0.2), duration: 0.6, ease: "easeInOut" },
    );
    animate(
      ".picture-aboutMe img",
      { y: [55, 0], opacity: [0, 1] },
      { delay: 0.3, duration: 0.8, ease: "easeInOut" },
    );
    animate(
      ".title-about",
      { y: [50, 0], opacity: [0, 1] },
      { delay: 0.8, duration: 0.8, ease: "easeInOut" },
    );
    animate(
      ".ucu",
      { y: [50, 0], opacity: [0, 1] },
      { delay: 1, duration: 0.8, ease: "easeInOut" },
    );
    animate(
      ".hr",
      { y: [50, 0], opacity: [0, 1] },
      { delay: 0.4, duration: 0.8, ease: "easeInOut" },
    );
    animate(
      ".blur-overlay",
      { y: [100, 0], opacity: [0, 1] },
      { delay: 0.3, duration: 0.8, ease: "easeOut" },
    );
  });
</script>
<style>
  .line {
    width: 10rem;
    height: 1px;
    background-color: #00000059;
  }
  .ucu-text {
    font-family: "PP Mori Bold", sans-serif;
    font-size: 18px;
    font-weight: 700;
  }
  .ucu {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .ucu-logo {
    width: 8rem;
    height: auto;
  }
  .title-about {
    font-family: "PP Mori Bold", sans-serif;
    font-size: 1.5rem;
    margin-top: 2rem;
    padding-left: 10rem;
  }
  hr {
    margin-top: 2rem;
    border: 1px solid #00000059;
    width: 100%;
  }

  .header-title {
    font-size: 2.5rem;
  }
  header.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 2rem;
    padding-inline: 8rem;
  }
  .content-about {
    display: grid;
    grid-template-columns: 50% 50%;
    padding-inline: 8rem;
    height: 80vh;
  }
  .picture-aboutMe {
    display: flex;
    position: relative;
    height: 95%;
  }
  @animate mask-reveal {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
  .blur-overlay {
    background: linear-gradient(#88744a00, #ffffff70);
    height: 75%;
    position: absolute;
    width: 90%;
    z-index: 1;
    border-radius: 2rem;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    mask-image: linear-gradient(to bottom, transparent 0%, black 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 100%);

    /* Le agregamos bottom: 0 para asegurar que se ancle abajo 
       y el efecto de "crecer" se vea desde abajo hacia arriba */
    bottom: 25%; /* Ajusta esto según dónde termine tu imagen */
    left: 0;
  }
  .picture-aboutMe img {
    width: 90%;
    height: 75%;
    object-fit: cover;
    border-radius: 2rem;
  }
  .text-about {
    display: flex;
    flex-direction: column;
    justify-content: right;
  }
  .text-about p {
    font-family: "PP Mori Regular", sans-serif;
    font-size: 14px;
    line-height: 1.5;
    padding-left: 10rem;
  }
  @media (max-width: 768px) {
    .text-about p {
      font-size: 12px;
      line-height: 1.3;
    }
    /* Permite que los hijos de .text-about interactúen directamente con la grilla */
    .text-about {
      display: contents;
    }

    /* Hace que SOLAMENTE la línea divisoria y el contenedor de logros ocupen el 100% */
    .hr,
    .goals-container {
      grid-column: 1 / -1;
      width: 100%;
    }

    .picture-aboutMe {
      justify-content: center;
      margin-bottom: 2rem;
      width: 90%;
      height: 100%;
      display: flex;
    }

    .picture-aboutMe img {
      width: 100%;
      height: auto;
    }

    .blur-overlay {
      height: 100%;
      width: 100%;
      top: 0;
    }

    .text-about p {
      padding-left: 0;
    }

    .title-about {
      padding-left: 0;
    }

    .ucu-logo {
      width: 5rem;
    }

    .ucu {
      width: 100%;
    }

    .line {
      flex: 1;
      width: auto;
    }
    .header-title {
      font-size: 1.5rem;
    }
    .nav-pills > a {
      font-size: 10rem;
    }
    .content-about {
      display: grid;
      grid-template-columns: 50% 50%;
      padding-inline: 2rem;
      height: auto;
      gap: 1rem;
      overflow-y: auto;
      grid-template-rows: 12em 15em;
    }
  }
</style>
