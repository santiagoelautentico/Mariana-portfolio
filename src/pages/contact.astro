---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Mariana Ferrari — Contacto" activeTab="contact">
  <h1
    slot="header-title"
    class="brand-title header-title"
    transition:name="brand-name"
  >
    MARIANA FERRARI
  </h1>

  <div class="content-about">
    <section class="contact-section">
      <div class="title-block">
        <h2 class="title-contact">Contacto</h2>
        <span class="form-label">Manda tu consulta:</span>
        <form action="https://api.web3forms.com/submit" method="POST">
          <input
            type="hidden"
            name="access_key"
            value="1b75cb12-1b47-4bbc-b64d-6a2a3249db3c"
          />

          <input
            type="text"
            id="name"
            name="name"
            placeholder="Nombre"
            required
          />
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Email"
            required
          />
          <textarea
            id="message"
            name="message"
            rows="5"
            placeholder="Mensaje"
            required></textarea>
          <button type="submit">Enviar</button>
        </form>
        <div class="links">
          <a
            href="https://www.instagram.com/contraluz.fs/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >
            <Icon class="icon" name="mdi:instagram" />
          </a>
          <a
            href="https://www.linkedin.com/in/mariana-ferrari-silva-60a190229/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
          >
            <Icon class="icon" name="mdi:linkedin" />
          </a>
          <a href="mailto:mferrarisilva@gmail.com" aria-label="Gmail">
            <Icon class="icon" name="mdi:gmail" />
          </a>
          <a
            href="https://wa.me/59891318029"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
          >
            <Icon class="icon" name="mdi:whatsapp" />
          </a>
        </div>
      </div>
    </section>
  </div>

  <style>
    .icon {
      width: 2rem;
      height: 2rem;
      transition: all 0.3s ease;
    }
    .icon:hover {
      color: #f599c5;
      transform: scale(1.2);
    }
    .header-title {
      font-size: 2.5rem;
    }
    header.navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-block: 2rem;
    }
    .contact-section {
      display: flex;
      flex-direction: column;
      margin-top: 2rem;
      overflow: hidden;
    }

    .title-block {
      display: flex;
      flex-direction: column;
      align-self: center; /* centra el bloque en el viewport */
      width: fit-content; /* el bloque mide lo mismo que su hijo más ancho (el h2) */
    }

    .title-contact {
      margin: 0;
      padding: 0;
      font-size: 8rem;
      font-family: "PP Kyoto Light";
      font-weight: 50;
      line-height: 1;
    }

    .form-label {
      align-self: flex-start;
      font-family: "PP Mori Regular";
      margin-bottom: 2rem;
    }
    form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    input,
    textarea {
      padding: 0.8rem;
      border-radius: 5px;
      border: 1px solid #f599c6;
      background-color: #ededed52;
      font-family: "PP Kyoto Light";
    }
    button {
      padding: 0.8rem;
      border-radius: 5px;
      border: 1px solid #f599c6;
      background-color: #f599c571;
      font-family: "PP Mori Regular";
      cursor: pointer;
      margin-inline: 10rem;
      color: rgb(57, 13, 20);
      transition: all 0.3s ease;
      box-shadow:
        rgba(0, 0, 0, 0.1) 0px 1px 3px 0px,
        rgba(0, 0, 0, 0.06) 0px 1px 2px 0px;
    }
    button:hover {
      background-color: #f599c5;
      border: 1px solid #ff007d;
      box-shadow:
        rgba(0, 0, 0, 0.1) 0px 4px 6px -1px,
        rgba(0, 0, 0, 0.06) 0px 2px 4px -1px;
    }

    .links {
      display: flex;
      gap: 5rem;
      margin-top: 2rem;
      justify-content: center;
    }
    @media (max-width: 768px) {
      .content-about {
        overflow: none;
      }
      .title-contact {
        font-size: 4rem;
      }
      .form-label {
        margin-bottom: 1rem;
      }
      button {
        margin-inline: 0;
      }
      .title-block {
        width: 80%;
      }
      .links {
        gap: 2rem;
        margin-top: 1rem;
      }
    }
  </style>
  <script>
    import { animate, press, hover, stagger } from "motion";

    const selector = "form button[type='submit']";

    hover(selector, (element) => {
      animate(element, { scale: 1.1 });
      return () => animate(element, { scale: 1 });
    });

    press(selector, (element) => {
      animate(element, { scale: 0.9 }, { duration: 0.15 });
      return () => animate(element, { scale: 1.1 }, { duration: 0.2 });
    });

    function initForm() {
      const form = document.getElementById("form") as HTMLFormElement | null;
      if (!form) return;

      const submitBtn = form.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        formData.append("access_key", "1b75cb12-1b47-4bbc-b64d-6a2a3249db3c");

        const originalText = submitBtn.textContent;
        submitBtn.textContent = "Enviando...";
        submitBtn.disabled = true;

        try {
          const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            body: formData,
          });
          const data = await response.json();

          if (data.success) {
            alert("¡Mensaje enviado! Gracias por escribirme.");
            form.reset();
          } else {
            alert("Error: " + data.message);
          }
        } catch {
          alert("Algo salió mal. Intentá de nuevo.");
        } finally {
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      });
    }

    function initAnimations() {
      animate(
        ".title-contact",
        { y: [55, 0], opacity: [0, 1] },
        { duration: 0.6, ease: "easeInOut" },
      );
      animate(
        ".form-label",
        { y: [55, 0], opacity: [0, 1] },
        { delay: 0.2, duration: 0.6, ease: "easeInOut" },
      );
      animate(
        "form",
        { y: [55, 0], opacity: [0, 1] },
        { delay: 0.4, duration: 0.6, ease: "easeInOut" },
      );
      animate(
        ".links",
        { y: [55, 0], opacity: [0, 1] },
        { delay: 0.6, duration: 0.6, ease: "easeInOut" },
      );
    }

    document.addEventListener("astro:page-load", () => {
      initForm();
      initAnimations();
    });
  </script>
</Layout>
