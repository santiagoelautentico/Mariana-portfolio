---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const proyectos = await getCollection("proyectos");
  return proyectos.map((proyecto) => ({
    params: { id: proyecto.data.id },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;

// Creamos un nuevo arreglo colocando el cover primero, seguido de las fotos
const todasLasFotos = [proyecto.data.cover, ...proyecto.data.photos];
const cantFotos = todasLasFotos.length;
---

<Layout title={`Mariana Ferrari — ${proyecto.data.title}`} activeTab="">
  <h1
    slot="header-title"
    class="brand-title header-title"
    transition:name="brand-name"
  >
    MARIANA FERRARI
  </h1>
  <section class="project-details">
    <h2 class="title-proyect">{proyecto.data.title}</h2>
    <ul>
      <li>Sesión: {proyecto.data.year}</li>
      <li>/</li>
      <li>set {cantFotos} fotos</li>
      {
        proyecto.data.model !== "" && (
          <>
            <li>/</li>
            <li>Modelo: {proyecto.data.model}</li>
          </>
        )
      }
    </ul>
  </section>
  <section class="gallery-container">
    <div class="gallery-viewport" id="gallery-viewport">
      <div class="gallery-track" id="gallery-track">
        {
          todasLasFotos.map((fotoUrl, index) => (
            <div class:list={["project-card", { "is-active": index === 0 }]}>
              <div
                class="image-wrapper"
                transition:name={
                  index === 0 ? `cover-${proyecto.data.id}` : undefined
                }
              >
                <img
                  src={fotoUrl}
                  alt={`${proyecto.data.title} - Foto ${index}`}
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : undefined}
                  draggable="false"
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <div class="blur blur-left"></div>
  <div class="blur blur-right"></div>
</Layout>

<style>
  .blur {
    position: absolute;
    top: 0;
    width: 4rem;
    height: 100%;
    z-index: 1;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 1),
      rgba(255, 255, 255, 0)
    );
  }
  .blur-left {
    left: 0;
  }
  .blur-right {
    right: 0;
    transform: rotate(180deg);
  }
  .project-details {
    display: flex;
    align-items: end;
    flex-direction: column;
    padding-inline: 8rem;
  }
  .title-proyect {
    font-size: 2rem;
    margin-bottom: 1rem;
    background: linear-gradient(#00000075, #2e2e2e);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-family: "PP Kyoto Light", sans-serif;
    font-weight: 10;
    margin: 0;
    padding: 0;
  }
  .project-details > ul {
    display: flex;
    gap: 0.5rem;
    font-family: "PP Mori Regular", sans-serif;
    font-size: 1rem;
    margin: 0;
    padding: 0;
  }
  .header-title {
    font-size: 2.5rem;
  }
  header.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 2rem;
  }

  /* ---------- Galería ---------- */
  .gallery-container {
    margin-top: 2rem;
    --small-w: 17rem;
    --small-h: 15rem;
    --big-w: 40rem; /* ancho de la foto activa */
    --big-max-h: 35rem; /* tope de alto para verticales muy altas */
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --dur: 0.5s;
  }
  .gallery-viewport {
    width: 100%;
    overflow: hidden; /* sin scroll del usuario */
    touch-action: pan-y; /* el scroll vertical de la página sigue andando */
    overscroll-behavior-x: contain;
    cursor: grab;
    user-select: none;
  }
  .gallery-viewport.dragging {
    cursor: grabbing;
  }
  .gallery-track {
    display: flex;
    align-items: center;
    gap: 2rem;
    width: max-content;
    min-height: var(--big-max-h);
    padding-inline: 6rem;
    will-change: transform;
    transition: transform var(--dur) var(--ease);
  }
  .project-card {
    flex: none;
    display: flex;
    align-items: center;
    --ar: 1.2; /* se pisa por JS con el aspect ratio real */
  }
  .image-wrapper {
    width: var(--small-w);
    height: var(--small-h);
    overflow: hidden;
    border-radius: 5px;
    transition:
      width var(--dur) var(--ease),
      height var(--dur) var(--ease);
  }
  .project-card.is-active .image-wrapper {
    width: min(var(--big-w), calc(var(--big-max-h) * var(--ar)));
    height: min(calc(var(--big-w) / var(--ar)), var(--big-max-h));
  }
  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    -webkit-user-drag: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-track,
    .image-wrapper {
      transition: none;
    }
  }
  @media (max-width: 768px) {
    .header-title {
      font-size: 1rem;
    }
    .gallery-container {
      margin-top: 3rem;
      --small-w: 11rem;
      --small-h: 9.5rem;
      --big-w: 17rem;
      --big-max-h: 22rem;
    }
    .gallery-track {
      padding-inline: 2rem;
    }
  }
</style>

<script>
  function initGallery() {
    const viewport = document.getElementById("gallery-viewport");
    const track = document.getElementById("gallery-track");
    if (!viewport || !track || track.dataset.ready) return;
    track.dataset.ready = "1";

    const container = viewport.parentElement as HTMLElement;
    const cards = Array.from(
      track.querySelectorAll<HTMLElement>(".project-card"),
    );
    const n = cards.length;
    const ars = cards.map(() => 1.2); // mismo default que --ar en CSS
    let current = 0;

    const DRAG_THRESHOLD = 40; // px de drag para pasar a la siguiente foto

    // Limpia los listeners globales al navegar con view transitions
    const ac = new AbortController();
    const { signal } = ac;
    document.addEventListener("astro:before-swap", () => ac.abort(), {
      once: true,
    });

    // Convierte un valor CSS (p. ej. "var(--small-w)") a px reales
    const px = (value: string) => {
      const probe = document.createElement("div");
      probe.style.cssText = `position:absolute;visibility:hidden;width:${value}`;
      container.appendChild(probe);
      const w = probe.offsetWidth;
      probe.remove();
      return w;
    };

    // Posiciona el track según la foto activa (calculado sobre el layout final)
    const render = () => {
      const vw = viewport.clientWidth;
      const cs = getComputedStyle(track);
      const padL = parseFloat(cs.paddingLeft);
      const padR = parseFloat(cs.paddingRight);
      const gap = parseFloat(cs.columnGap) || 0;
      const smallW = px("var(--small-w)");
      const bigW = px("var(--big-w)");
      const bigMaxH = px("var(--big-max-h)");

      const activeW = Math.min(bigW, bigMaxH * ars[current]);
      const center = padL + current * (smallW + gap) + activeW / 2;
      const contentW = padL + padR + (n - 1) * smallW + (n - 1) * gap + activeW;

      // Foto activa centrada, pero sin pasarse de los extremos del track
      const minX = Math.min(0, vw - contentW);
      const x = Math.min(0, Math.max(minX, vw / 2 - center));

      cards.forEach((c, i) => c.classList.toggle("is-active", i === current));
      track.style.transform = `translateX(${x}px)`;
    };

    const go = (index: number) => {
      const next = Math.max(0, Math.min(n - 1, index));
      if (next === current) return;
      current = next;
      render();
    };

    // Aspect ratio real de cada foto
    cards.forEach((card, i) => {
      const img = card.querySelector("img");
      if (!img) return;
      const setAr = () => {
        if (!img.naturalWidth || !img.naturalHeight) return;
        ars[i] = img.naturalWidth / img.naturalHeight;
        card.style.setProperty("--ar", String(ars[i]));
        render();
      };
      if (img.complete) setAr();
      else img.addEventListener("load", setAr, { once: true });
    });

    // Drag: un solo paso por gesto, sin importar cuánto arrastres
    let dragging = false;
    let stepped = false;
    let startX = 0;

    viewport.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse" && e.button !== 0) return;
      dragging = true;
      stepped = false;
      startX = e.clientX;
      viewport.setPointerCapture(e.pointerId);
      viewport.classList.add("dragging");
    });
    viewport.addEventListener("pointermove", (e) => {
      if (!dragging || stepped) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) >= DRAG_THRESHOLD) {
        stepped = true;
        go(current + (dx < 0 ? 1 : -1));
      }
    });
    const endDrag = () => {
      dragging = false;
      viewport.classList.remove("dragging");
    };
    viewport.addEventListener("pointerup", endDrag);
    viewport.addEventListener("pointercancel", endDrag);
    viewport.addEventListener("dragstart", (e) => e.preventDefault());

    // Teclado
    document.addEventListener(
      "keydown",
      (e) => {
        if (e.key === "ArrowRight") {
          e.preventDefault();
          go(current + 1);
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          go(current - 1);
        }
      },
      { signal },
    );

    window.addEventListener("resize", render, { signal });
    render();
  }

  initGallery();
  document.addEventListener("astro:page-load", initGallery);
</script>
<script is:inline define:vars={{ id: proyecto.data.id }}>
  const ar = sessionStorage.getItem(`ar:${id}`);
  if (ar)
    document
      .querySelector("#gallery-track .project-card")
      ?.style.setProperty("--ar", ar);
</script>